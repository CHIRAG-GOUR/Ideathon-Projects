# Optional for local development only. A deployed site reads its config from Firebase Hosting (/__/firebase/init.json),
# so nothing needs to be set for production. These are browser-safe web config values, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=beyond-legacy-app
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
