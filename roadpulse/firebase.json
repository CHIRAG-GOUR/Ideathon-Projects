{
  "hosting": {
    "site": "roadpulse-ideathon",
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "edge/**",
      "android/**"
    ],
    "frameworksBackend": {
      "region": "asia-south1",
      "maxInstances": 5
    }
  },
  "firestore": [
    {
      "database": "roadpulse",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": [
    {
      "target": "roadpulse",
      "rules": "storage.rules"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
