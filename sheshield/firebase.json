{
  "hosting": {
    "site": "she-shield-app",
    "public": "web/out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "sheshieldApi", "region": "asia-south1" } },
      { "source": "/live/**", "destination": "/live.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), microphone=(self), camera=()" }
      ] },
      { "source": "/live/**", "headers": [ { "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex" } ] },
      { "source": "/_next/static/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "sheshield", "runtime": "nodejs22", "ignore": ["node_modules", "src", "test", ".secret.local", "*.log"] }
  ],
  "firestore": [
    { "database": "sheshield", "rules": "firestore.rules", "indexes": "firestore.indexes.json" }
  ],
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5055 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
