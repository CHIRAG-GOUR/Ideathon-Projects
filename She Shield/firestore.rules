rules_version = '2';
// She Shield — own database "sheshield". Every record belongs to one user; nothing is public.
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Safety Core (shared by every app; each app has its own project/database) ----
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }

    function validUser(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'profile', 'settings', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && (d.phone == null || (d.phone is string && d.phone.matches('^\\+[1-9][0-9]{6,14}$')))
        && optStr(d, 'email', 120)
        && d.profile is map && d.profile.shareMedical is bool
        && optStr(d.profile, 'bloodGroup', 5) && optStr(d.profile, 'allergies', 300) && optStr(d.profile, 'medicalNotes', 500)
        && d.settings is map && d.settings.sound is bool && d.settings.vibration is bool
        && d.settings.retentionDays is int && d.settings.retentionDays >= 1 && d.settings.retentionDays <= 365;
    }

    function validContact(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'role', 'relationship', 'channels', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && (d.phone == null || (d.phone is string && d.phone.matches('^\\+[1-9][0-9]{6,14}$')))
        && (d.email == null || (d.email is string && d.email.size() <= 120))
        && (d.phone != null || d.email != null)
        && d.role in ['primary', 'family', 'friend', 'emergency']
        && d.relationship is string && d.relationship.size() <= 30
        && d.channels.keys().hasOnly(['sms', 'whatsapp', 'email', 'live'])
        && d.channels.sms is bool && d.channels.whatsapp is bool && d.channels.email is bool && d.channels.live is bool;
    }

    match /users/{uid} {
      allow read: if me(uid);
      allow create, update: if me(uid) && validUser(request.resource.data);
      match /contacts/{cid} {
        allow read: if me(uid);
        allow create, update: if me(uid) && validContact(request.resource.data);
        // Deletion goes through the API so the contact's live link is revoked at the same time.
      }
      match /checks/{id} { allow read: if me(uid); }
      match /checkLog/{id} { allow read: if me(uid); }
    }

    // An SOS is readable by its owner only. Contacts see it through their token via the API — never directly.
    match /sosEvents/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /{sub}/{doc} { allow read: if signedIn() && get(/databases/$(database)/documents/sosEvents/$(id)).data.ownerUid == request.auth.uid; }
    }
    // devices, shareTokens, smsDeliveries: server only.
    // ---- She Shield ----
    // Shield Mode sessions (on/off) for the protection activity log.
    match /users/{uid}/shieldLog/{id} {
      allow read: if me(uid);
      allow create: if me(uid) && request.resource.data.keys().hasOnly(['type', 'at'])
        && request.resource.data.type in ['on', 'off'] && request.resource.data.at is string;
    }
    // Safety Evidence Vault: notes and file references; files themselves are in Storage (owner-only).
    match /users/{uid}/vault/{id} {
      allow read, delete: if me(uid);
      allow create: if me(uid) && request.resource.data.keys().hasOnly(['kind', 'title', 'text', 'path', 'contentType', 'size', 'at', 'location'])
        && request.resource.data.kind in ['note', 'photo', 'audio']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && (request.resource.data.text == null || (request.resource.data.text is string && request.resource.data.text.size() <= 5000))
        && (request.resource.data.path == null || request.resource.data.path.matches('users/' + uid + '/vault/.*'));
    }
  }
}
