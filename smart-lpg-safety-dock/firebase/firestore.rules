rules_version = '2';
// Smart LPG Safety Dock — dedicated project. Every document belongs to one signed-in user.
// The simulation itself never needs Firestore; these collections only hold saved history.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    function ownsNew() { return signedIn() && request.resource.data.ownerUid == request.auth.uid; }
    function str(v, max) { return v is string && v.size() <= max; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'updatedAt'])
        && str(request.resource.data.displayName, 80);
    }

    match /simulationSessions/{id} {
      allow read, delete: if mine();
      allow create: if ownsNew()
        && request.resource.data.keys().hasOnly(['id', 'scenario', 'mode', 'startedAt', 'durationSec', 'outcome', 'peakGas', 'maxTemp', 'maxTilt', 'cylinderId', 'ownerUid', 'eventCount', 'createdAt'])
        && request.resource.data.scenario in ['with', 'without']
        && request.resource.data.mode in ['scripted', 'free']
        && request.resource.data.outcome in ['CONTAINED', 'ESCALATION']
        && request.resource.data.durationSec is number && request.resource.data.durationSec >= 0 && request.resource.data.durationSec < 36000
        && request.resource.data.eventCount is int && request.resource.data.eventCount <= 500;
    }

    match /simulationEvents/{id} {
      allow read, delete: if mine();
      allow create: if ownsNew()
        && request.resource.data.keys().hasOnly(['t', 'kind', 'level', 'text', 'sessionId', 'ownerUid'])
        && request.resource.data.t is number && str(request.resource.data.kind, 40) && str(request.resource.data.text, 200)
        && request.resource.data.level in ['info', 'notice', 'warning', 'critical', 'success']
        && str(request.resource.data.sessionId, 64);
    }

    match /devices/{deviceId} {
      // Future hardware: a user's registered docks and their configuration.
      allow read, delete: if mine();
      allow create, update: if ownsNew()
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'cylinderId', 'thresholds', 'createdAt', 'updatedAt'])
        && str(request.resource.data.name, 60) && str(request.resource.data.cylinderId, 40);
    }

    match /presentationSessions/{id} {
      allow read, delete: if mine();
      allow create: if ownsNew()
        && request.resource.data.keys().hasOnly(['ownerUid', 'startedAt', 'endedAt', 'chaptersViewed'])
        && request.resource.data.chaptersViewed is list && request.resource.data.chaptersViewed.size() <= 20;
    }
  }
}
