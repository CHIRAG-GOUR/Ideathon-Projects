# Copy to .env.local for development. Never commit real secrets.

# --- Public Firebase web config (safe for the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ideathon-projects.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ideathon-projects
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=roadpulse
NEXT_PUBLIC_STORAGE_BUCKET=roadpulse-ideathon

# --- Map tiles (OpenStreetMap by default; set your own provider for heavy use) ---
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Server only ---
# Reverse geocoding (OpenStreetMap Nominatim). Put a real contact address — required by its usage policy.
GEOCODER_CONTACT=you@example.com
# GEOCODER_URL=https://nominatim.openstreetmap.org
# Email adapter (only needed for authorities that officially accept email reports). Stored as a secret when deployed.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=RoadPulse <reports@your-domain>
# API keys for authority API adapters: the authority's `apiKeySecret` names the env var, e.g.
# AUTHORITY_KEY_EXAMPLE=...
