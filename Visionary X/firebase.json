{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/scan",
        "destination": "/scanner",
        "type": 302
      },
      {
        "source": "/barcodes",
        "destination": "/demo",
        "type": 302
      },
      {
        "source": "/simulation",
        "destination": "/warehouse",
        "type": 302
      },
      {
        "source": "/app",
        "destination": "/dashboard",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "camera=(self)"
          }
        ]
      }
    ],
    "site": "visionary-x-ideathon"
  }
}