{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true,
    "noUnusedLocals": true, "noUnusedParameters": false,
    "paths": { "@/*": ["./src/*"], "@engine/*": ["../shared/src/*"], "@shared/*": ["../shared/*"] }
  },
  "include": ["src", "../shared/src", "vite.config.ts"]
}
